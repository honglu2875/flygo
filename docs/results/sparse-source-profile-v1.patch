+    /// Experimental source-driven multiply for very sparse input activity.
+    /// Each worker owns a destination interval. Visiting active sources in
+    /// ascending order preserves every destination's canonical reduction order.
+    /// This is a profiling candidate; the production selector is unchanged.
+    pub fn multiply_sources(
+        &self,
+        graph: &Graph,
+        weights: &[f32],
+        input: &[f32],
+        batch: usize,
+    ) -> Vec<f32> {
+        // Preserve IEEE products such as infinity times an otherwise skipped zero.
+        if weights.iter().any(|x| !x.is_finite()) {
+            return self.multiply(graph, weights, input, batch);
+        }
+        let active: Vec<usize> = input.chunks(batch).enumerate()
+            .filter_map(|(source, row)| row.iter().any(|&x| x != 0.0).then_some(source))
+            .collect();
+        let rows_per_worker = graph.neurons().div_ceil(self.pool.current_num_threads());
+        let mut output = vec![0.0; input.len()];
+        self.pool.install(|| {
+            output.par_chunks_mut(rows_per_worker * batch).enumerate().for_each(|(chunk, out)| {
+                let first = chunk * rows_per_worker;
+                let last = first + out.len() / batch;
+                for &source in &active {
+                    let start = graph.transpose_indptr[source];
+                    let end = graph.transpose_indptr[source + 1];
+                    let destinations = &graph.transpose_src[start..end];
+                    let begin = destinations.partition_point(|&destination| destination < first);
+                    let finish = destinations.partition_point(|&destination| destination < last);
+                    for offset in begin..finish {
+                        let destination = destinations[offset];
+                        let weight = weights[graph.transpose_edges[start + offset]];
+                        let row = &mut out[(destination - first) * batch..(destination - first + 1) * batch];
+                        for (value, &x) in row.iter_mut().zip(&input[source * batch..(source + 1) * batch]) {
+                            *value += weight * x;
+                        }
+                    }
+                }
+            });
+        });
+        output
